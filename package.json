{
  "name": "dsh-agents-desk",
  "version": "0.2.0",
  "description": "Edit every AGENTS.md instruction file DSH actually loads, see the effective chain, review history, and draft project rules with the model.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agents-md",
    "instructions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cassius0924/dsh-agents-desk.git"
  },
  "homepage": "https://github.com/Cassius0924/dsh-agents-desk#readme",
  "dsh": {
    "compat": {
      "testedOn": "0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
